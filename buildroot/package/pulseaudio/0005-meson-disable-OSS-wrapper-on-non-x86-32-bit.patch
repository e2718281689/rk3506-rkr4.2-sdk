From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sisyphus <noreply@example.com>
Date: Sun, 31 May 2026 12:00:00 +0000
Subject: [PATCH] meson: disable OSS wrapper on non-x86 32-bit

`padsp.c` intentionally undefines `_FILE_OFFSET_BITS` so it can interpose
legacy libc entry points. On 32-bit glibc builds with `-D_TIME_BITS=64`,
that becomes invalid and the build aborts in `features-time64.h`.

Keep optional OSS output detection, but only build the legacy OSS wrapper
(`libpulsedsp`/`padsp`) on x86 or 64-bit targets where this compatibility
path still works.

Signed-off-by: Sisyphus <noreply@example.com>
---
 meson.build | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/meson.build b/meson.build
index 70943f0..f14a61f 100644
--- a/meson.build
+++ b/meson.build
@@ -620,8 +620,11 @@ x11_dep = dependency('x11-xcb', required : get_option('x11'))
 if cc.has_header('sys/soundcard.h', required: get_option('oss-output'))
   # OSS output via daemon module-detect
   cdata.set('HAVE_OSS_OUTPUT', 1)
-  # OSS wrapper
-  cdata.set('HAVE_OSS_WRAPPER', 1)
+  # The legacy OSS wrapper drops _FILE_OFFSET_BITS internally and is not
+  # compatible with 32-bit non-x86 glibc time64 builds.
+  if cc.sizeof('void *') >= 8 or host_machine.cpu_family() == 'x86'
+    cdata.set('HAVE_OSS_WRAPPER', 1)
+  endif
   cdata.set('PULSEDSP_LOCATION', pulsedsp_location)
 endif
 
-- 
